{
  "name": "neobbs",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "neobbs",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "examples/*"
      ]
    },
    "examples/basic": {
      "name": "@neobbs/example-basic",
      "version": "0.1.0",
      "dependencies": {
        "@neobbs/core": "*"
      }
    },
    "node_modules/@neobbs/app-blog": {
      "resolved": "packages/app-blog",
      "link": true
    },
    "node_modules/@neobbs/app-forum": {
      "resolved": "packages/app-forum",
      "link": true
    },
    "node_modules/@neobbs/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@neobbs/example-basic": {
      "resolved": "examples/basic",
      "link": true
    },
    "node_modules/@neobbs/renderer-terminal": {
      "resolved": "packages/renderer-terminal",
      "link": true
    },
    "packages/app-blog": {
      "name": "@neobbs/app-blog",
      "version": "0.1.0",
      "dependencies": {
        "@neobbs/core": "*"
      }
    },
    "packages/app-forum": {
      "name": "@neobbs/app-forum",
      "version": "0.1.0",
      "dependencies": {
        "@neobbs/core": "*"
      }
    },
    "packages/core": {
      "name": "@neobbs/core",
      "version": "0.1.0"
    },
    "packages/renderer-terminal": {
      "name": "@neobbs/renderer-terminal",
      "version": "0.1.0"
    }
  }
}
